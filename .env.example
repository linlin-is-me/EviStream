EVISTREAM_ENVIRONMENT=development
EVISTREAM_CORS_ORIGINS=["http://localhost:5173"]
EVISTREAM_MODEL_PROFILE=mock
EVISTREAM_MODEL_CONFIG_DIR=configs/models
EVISTREAM_MODEL_BASE_URL=https://your-provider.example/v1
EVISTREAM_MODEL_API_KEY=
EVISTREAM_AGENT_MODEL=your-text-or-multimodal-model
EVISTREAM_TRIAGE_MODEL=your-vision-model
EVISTREAM_VERIFY_MODEL=your-vision-model
EVISTREAM_JUDGE_MODEL=your-judge-model
EVISTREAM_FFMPEG_BINARY=ffmpeg
EVISTREAM_FFPROBE_BINARY=ffprobe
EVISTREAM_PROCESS_TIMEOUT_SECONDS=30
EVISTREAM_ASR_BACKEND=mock
EVISTREAM_ASR_MODEL=tiny.en
EVISTREAM_ASR_DEVICE=cpu
EVISTREAM_ASR_COMPUTE_TYPE=int8

# Frontend: set this in apps/web/.env.local only when the API is on another origin.
VITE_API_BASE_URL=
